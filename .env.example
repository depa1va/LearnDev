VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: configure somente ao ativar o Firebase App Check com reCAPTCHA v3.
VITE_FIREBASE_APP_CHECK_RECAPTCHA_SITE_KEY=

# Opcional: use "true" apenas ao executar a Firebase Emulator Suite localmente.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Apenas servidor (Vercel): Firebase Admin para os endpoints autenticados.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Apenas servidor (Vercel): envio de verificação de e-mail.
RESEND_API_KEY=

# Apenas servidor (Vercel): usados pelos endpoints autenticados de avatar.
# Nunca prefixe estas variáveis com VITE_ e nunca exponha CLOUDINARY_API_SECRET no navegador.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
